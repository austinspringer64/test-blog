---
import { SITE_AUTHOR, SOCIAL_LINKS } from '../consts';

const today = new Date();
---

<footer>
  <div>
    &copy; {today.getFullYear()} {SITE_AUTHOR}. All rights reserved.
  </div>
  <div class="social-links">
    <a href={SOCIAL_LINKS.github} target="_blank" rel="noopener noreferrer">
      <span class="sr-only">Go to my GitHub repo</span>
      <svg
        viewBox="0 0 16 16"
        aria-hidden="true"
        width="32"
        height="32"
        astro-icon="social/github"
      >
        <path
          fill="currentColor"
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
        />
      </svg>
    </a>
    <a href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener noreferrer">
      <span class="sr-only">Find me on LinkedIn</span>
      <svg
        viewBox="0 0 16 16"
        aria-hidden="true"
        width="32"
        height="32"
      >
<path 
fill="currentColor" 
d="M14.4 0H1.6C.72 0 0 .72 0 1.6v12.8C0 15.28.72 16 1.6 16h12.8c.88 0 1.6-.72 1.6-1.6V1.6c0-.88-.72-1.6-1.6-1.6zM4.8 13.6H2.4V6h2.4v7.6zM3.6 5.2c-.66 0-1.2-.54-1.2-1.2s.54-1.2 1.2-1.2 1.2.54 1.2 1.2-.54 1.2-1.2 1.2zm10 8.4h-2.4v-4c0-.96-.02-2.2-1.34-2.2-1.34 0-1.55 1.05-1.55 2.1v4.1H6V6h2.3v1c.3-.58 1.02-1.2 2.12-1.2 2.28 0 2.7 1.5 2.7 3.4v4.4z"/>
      </svg>
    </a>
  </div>
</footer>

<style>
  footer {
    padding: 2em 1em;
    background: var(--background-light);
    color: rgb(var(--gray-dark));
    text-align: center;
    box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.3);
  }
  .social-links {
    display: flex;
    justify-content: center;
    gap: 1em;
    margin-top: 1em;
  }
  .social-links a {
    text-decoration: none;
    color: rgb(var(--gray-dark));
    transition: color 0.2s ease;
  }
  .social-links a:hover {
    color: var(--accent);
  }
</style>
