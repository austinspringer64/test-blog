---
import { SITE_AUTHOR } from '../consts';

const today = new Date();
---

<footer>
  <div>
    &copy; {today.getFullYear()} {SITE_AUTHOR}. All rights reserved.
  </div>
</footer>

<style>
  footer {
    padding: 2em 1em;
    background: var(--background-light);
    color: rgb(var(--gray-dark));
    text-align: center;
    box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.3);
  }
</style>
