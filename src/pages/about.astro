---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${SITE_TITLE}`} description="Learn more about Austin Springer." />
	</head>
	<body>
		<Header />
		<main>
			<h1>About</h1>
			<p>
				I write about software engineering, open source, and projects that I build along the way.
			</p>

			<p>
				When I am not coding, I am usually outside hiking, camping, or spending time with my dog.
			</p>
		</main>
		<Footer />
	</body>
</html>
